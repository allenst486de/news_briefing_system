# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# GitHub Pages URL (will be set after repository creation)
PAGES_BASE_URL=https://yourusername.github.io/news_briefing_system

# NVIDIA NIM API (무료 티어) - 요약/번역/재구성용 LLM 호출
# 비워두면 카테고리별 요약이 자동으로 규칙기반 폴백으로 동작합니다.
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- 로컬 LLM 폴백 (선택) ---
# 클라우드 호출이 실패한 청크만 로컬 모델이 받아냅니다. 예전에는 클라우드가 실패하면
# 곧장 규칙기반으로 떨어져 지면에 영문 원문이 그대로 노출됐습니다.
# LM Studio 등 OpenAI 호환 서버가 떠 있어야 하며, 꺼져 있으면 조용히 건너뜁니다.
# 클라우드와 같은 계열 모델을 쓰는 것이 품질 일관성에 유리합니다.
LOCAL_LLM_ENABLED=1
LOCAL_LLM_URL=http://localhost:1234/v1/chat/completions
LOCAL_LLM_MODEL=google/gemma-4-31b-qat
# 로컬은 청크당 약 277초(M4 Pro 48GB 실측)라 타임아웃을 넉넉히 잡습니다.
LOCAL_LLM_TIMEOUT=900
# 통합 메모리 대역폭이 병목이라 동시 호출을 늘려도 총 처리량이 거의 안 늘어납니다
# (실측: 단일 48.8 tok/s → 4병렬 57.5 tok/s). 좁게 유지하세요.
LOCAL_LLM_CONCURRENCY=2
# 로컬 폴백 총 시간 예산(초). 폴백률 20%(약 15청크) × 277초 ≈ 70분을 감당하는 값.
LOCAL_LLM_TIME_BUDGET_SECONDS=5400

